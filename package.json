{
  "name": "timmy-timer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "cloudflare:config": "node scripts/create-cloudflare-config.mjs",
    "cloudflare:build": "npm run cloudflare:config && npm run build",
    "cloudflare:publish": "wrangler d1 migrations apply DB --remote && wrangler deploy --config dist/server/wrangler.json",
    "cloudflare:deploy": "npm run cloudflare:build && npm run cloudflare:publish"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260901.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "node-addon-api": "8.5.0",
    "node-gyp": "11.4.2",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
